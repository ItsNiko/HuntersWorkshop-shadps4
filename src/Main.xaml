<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Hunter's Workshop" Width="1390" Height="930" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#111216" Foreground="#E6E0D5" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#4A3B43" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="170"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="#15161A"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="H U N T E R ' S   W O R K S H O P" FontSize="10" Foreground="#A9A09A" VerticalAlignment="Center" Margin="18,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="v0.2.0" FontSize="10" Foreground="#8F8682" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="Minimize" Content="—" Style="{StaticResource QuietButton}" Padding="17,4"/><Button x:Name="Maximize" Content="□" Style="{StaticResource QuietButton}" Padding="17,4"/><Button x:Name="Close" Content="×" Style="{StaticResource QuietButton}" FontSize="19" Padding="17,1"/></StackPanel></Grid>
  <Grid Grid.Row="1" ClipToBounds="True"><Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF141419" Offset="0"/><GradientStop Color="#ED141419" Offset="0.35"/><GradientStop Color="#30141419" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border BorderBrush="#423039" BorderThickness="0,0,0,1"/><Grid Margin="30,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Image x:Name="BrandIcon" Width="74" Height="110" Margin="0,0,22,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="B L O O D B O R N E   /   N A T I V E   P C" Style="{StaticResource Eyebrow}"/><TextBlock Text="Hunter's Workshop" FontFamily="Georgia" FontSize="36" Margin="0,7,0,5"/><TextBlock Text="Every hunt begins with a choice." Style="{StaticResource MutedText}" Foreground="#B7ADA5"/></StackPanel><Border Grid.Column="2" Background="#D91C1C22" BorderBrush="#554049" BorderThickness="1" CornerRadius="6" Padding="16" VerticalAlignment="Center"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="YOUR SESSION" Style="{StaticResource Eyebrow}"/><Ellipse x:Name="StatusDot" Grid.Column="1" Width="7" Height="7" Fill="#74676B"/></Grid><TextBlock x:Name="Status" Text="Waiting for Bloodborne" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,11"/><Button x:Name="Connect" Content="Connect to Bloodborne" Style="{StaticResource PrimaryButton}" Padding="10,9"/></StackPanel></Border></Grid></Grid>
  <Grid Grid.Row="2" x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#16171B" BorderBrush="#2B292E" BorderThickness="0,0,1,0"><Grid Margin="0,20,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="THE WORKSHOP" Style="{StaticResource Eyebrow}" Margin="25,0,0,14"/><ToggleButton x:Name="NavItems" Content="◇   Items &amp; equipment" Style="{StaticResource Navigation}"/><ToggleButton x:Name="NavGems" Content="◈   Blood gem studio" Style="{StaticResource Navigation}"/><ToggleButton x:Name="NavFavorites" Content="☆   Favorites" Style="{StaticResource Navigation}"/><ToggleButton x:Name="NavSession" Content="☾   Session &amp; backups" Style="{StaticResource Navigation}"/></StackPanel><StackPanel Grid.Row="2" Margin="24,0,18,0"><TextBlock Text="BUILT FOR" Style="{StaticResource Eyebrow}"/><TextBlock Text="visy native 0.6.7 / 0.6.8" FontSize="12" Margin="0,7,0,4"/><TextBlock Text="Bloodborne 1.09 · Windows x64" Style="{StaticResource MutedText}" FontSize="10"/><Border BorderBrush="#363037" BorderThickness="0,1,0,0" Margin="0,16,0,12"/><Button x:Name="GitHub" Content="Source &amp; support  ↗" Style="{StaticResource QuietButton}" Padding="0,7" HorizontalContentAlignment="Left"/><TextBlock Text="Independent community tool" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Grid></Border>
   <Grid Grid.Column="1" Margin="24,22,24,20">
    <Grid x:Name="ItemsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ItemsHeading" Text="Items &amp; equipment" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Base game, The Old Hunters, and the treasures beneath Yharnam." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="ItemCount" Grid.Column="1" Foreground="#B4A39F" FontSize="11" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="ItemSearch" Tag="Search a name, weapon, or item ID…"/><Grid Grid.Row="1" Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="Category" Margin="0,0,8,0"/><ComboBox x:Name="Variant" Grid.Column="1"/></Grid><Border Grid.Row="2" BorderBrush="#303036" BorderThickness="1" CornerRadius="5" ClipToBounds="True"><Grid><DataGrid x:Name="ItemGrid"><DataGrid.Columns><DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="*" MinWidth="165"/><DataGridTextColumn Header="VARIANT" Binding="{Binding Variant}" Width="88"/><DataGridTextColumn Header="ITEM ID" Binding="{Binding DisplayId}" Width="98"/></DataGrid.Columns></DataGrid><TextBlock x:Name="NoItems" Text="No items match this search.&#10;Try another name or clear the filters." Foreground="#ABA19E" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border><CheckBox x:Name="AdvancedItems" Grid.Row="3" Content="Include unused and unnamed items" Margin="0,12,0,0"/></Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="YOUR SELECTION" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="Favorite" Grid.Column="1" Content="☆" ToolTip="Add or remove favorite (Ctrl+D)" Style="{StaticResource QuietButton}" Padding="5,0" FontSize="23"/></Grid><TextBlock x:Name="ItemName" Text="Choose an item" FontFamily="Georgia" FontSize="24" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock x:Name="ItemBadge" Foreground="#CB8A8F" FontSize="10" Margin="0,0,0,17"/><TextBlock x:Name="Description" Style="{StaticResource MutedText}" LineHeight="19" MaxHeight="152" TextTrimming="CharacterEllipsis"/><TextBlock Text="QUANTITY" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Button x:Name="Less" Content="−" Padding="0,9"/><TextBox x:Name="Quantity" Grid.Column="1" Text="1" Margin="6,0" HorizontalContentAlignment="Center"/><Button x:Name="More" Grid.Column="2" Content="+" Padding="0,9"/></Grid><TextBlock x:Name="ItemLimit" Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,0"/><TextBlock Text="REINFORCEMENT" Style="{StaticResource Label}"/><ComboBox x:Name="Upgrade"/><TextBlock x:Name="UnusedNote" Text="Unused content may have incomplete models or behavior." Foreground="#D9A883" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0" Visibility="Collapsed"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,15,0,0"><Button x:Name="GiveItem" Content="Give selected item" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Grants persist in your save." Style="{StaticResource MutedText}" FontSize="10" TextAlignment="Center" Margin="0,9,0,0"/></StackPanel></Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="GemsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Blood gem studio" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Chalice strengths. Every shape. A creation of your own." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="EffectCount" Grid.Column="1" Foreground="#B4A39F" FontSize="11" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="EffectSearch" Tag="Search effects, e.g. physical 27.2 or stamina…"/><Grid Grid.Row="1" Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GemKind" Margin="0,0,10,0"/><CheckBox x:Name="AdvancedEffects" Grid.Column="1" Content="Unnamed" VerticalAlignment="Center" ToolTip="Show all parameter effects, including unused entries."/></Grid><Border Grid.Row="2" BorderBrush="#303036" BorderThickness="1" CornerRadius="5" ClipToBounds="True"><Grid><DataGrid x:Name="EffectGrid"><DataGrid.Columns><DataGridTextColumn Header="GEM / RUNE" Binding="{Binding Name}" Width="*" MinWidth="135"/><DataGridTextColumn Header="EFFECT" Binding="{Binding Effect}" Width="185"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="72"/></DataGrid.Columns></DataGrid><TextBlock x:Name="NoEffects" Text="No effects match this search." Foreground="#ABA19E" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="124"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="TargetSlot" Margin="0,0,8,0"/><Button x:Name="UseEffect" Grid.Column="1" Content="Assign selected effect  →"/></Grid><TextBlock Grid.Row="4" Text="Double-click an effect to assign it. Click a slot to choose its position." Style="{StaticResource MutedText}" FontSize="10" Margin="0,9,0,0"/></Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="YOUR CREATION" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="GemTitle" Text="Custom blood gem" FontFamily="Georgia" FontSize="22" Margin="0,8,0,6"/><ComboBox x:Name="Shape" Margin="0,5,0,12"/><StackPanel x:Name="Slots"/><Expander Header="Template &amp; saved recipes" Foreground="#B8AFA9" Margin="0,7,0,0"><StackPanel Margin="0,9,0,0"><TextBlock Text="Source template" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox x:Name="GemSource"/><TextBlock Text="Saved recipe" Style="{StaticResource MutedText}" Margin="0,12,0,6"/><ComboBox x:Name="RecipeList" DisplayMemberPath="Name"/><Button x:Name="LoadRecipe" Content="Load selected recipe" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ClearEffects" Content="Clear extras" Style="{StaticResource QuietButton}" Padding="5,7"/><Button x:Name="SaveRecipe" Grid.Column="1" Content="Save recipe" Style="{StaticResource QuietButton}" Padding="5,7"/></Grid><Button x:Name="GiveGem" Content="Create blood gem" Style="{StaticResource PrimaryButton}" Margin="0,7,0,0"/><TextBlock Text="Custom combinations can exceed natural drop rules." Style="{StaticResource MutedText}" FontSize="10" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="SessionPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Session &amp; backups" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Keep your hunter's progress close, and a recovery point closer." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel><TextBlock Text="THE NATIVE PORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="visy 0.6.7 / 0.6.8 · Bloodborne 1.09" FontFamily="Georgia" FontSize="22" Margin="0,8,0,7"/><TextBlock Text="The exact supported executable is checked before connecting. Grant items in your own world, before joining a friend or while hosting." Style="{StaticResource MutedText}"/><TextBlock Text="PORT FOLDER" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PortPath" IsReadOnly="True" Tag="Detected when you connect, or choose a folder…"/><Button x:Name="BrowsePort" Grid.Column="1" Content="Choose folder" Margin="10,0,0,0"/></Grid><TextBlock x:Name="SavePath" Text="Saves are detected from the running game's launch arguments." Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel><TextBlock Text="SAVE SNAPSHOTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="A little peace of mind" FontFamily="Georgia" FontSize="22" Margin="0,8,0,7"/><TextBlock Text="Solo and party saves are copied together and checked with SHA-256. The first grant for each loaded character creates a snapshot automatically. For your best recovery point, make a backup with the game closed." Style="{StaticResource MutedText}" LineHeight="19"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="Backup" Content="Back up saves now" Style="{StaticResource PrimaryButton}" Padding="16,10"/><Button x:Name="OpenBackups" Content="Open backup folder  ↗" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="BackupStatus" Text="Snapshots stay in your Windows application-data folder." Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/><Expander Header="How to restore a snapshot" Foreground="#B8AFA9" Margin="0,15,0,0"><TextBlock Text="Close Bloodborne first. Keep a copy of the current saves, then copy the snapshot's savedata or savedata_party folder back into the native port's user folder, preserving the folder names. The Workshop never restores or renames saves automatically." Style="{StaticResource MutedText}" LineHeight="19" Margin="0,8,0,0"/></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="OpenData" Grid.Column="1" Content="Open local files  ↗" Style="{StaticResource QuietButton}" Padding="0,0"/></Grid><ListBox x:Name="History" Background="Transparent" BorderThickness="0" MaxHeight="220" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,9"><TextBlock Text="{Binding Time}" Foreground="#887E7D" FontSize="10"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#C3BDB6" FontSize="12" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></StackPanel></ScrollViewer></Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="#18171C" BorderBrush="#352A32" BorderThickness="0,1,0,0" Padding="20,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="ActivityDot" Width="5" Height="5" Fill="#8C747C" VerticalAlignment="Center"/><TextBlock x:Name="Activity" Grid.Column="1" Text="Launch Bloodborne, load a hunter in your own world, and connect." FontSize="12" Foreground="#B6AAA5" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center"/><ProgressBar x:Name="BusyProgress" Grid.Column="2" Width="90" Height="3" Foreground="#BD6878" Background="#392A34" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/></Grid></Border>
 </Grid></Border>
</Window>
